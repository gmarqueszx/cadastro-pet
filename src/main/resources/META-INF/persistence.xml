<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="PETS_PU" transaction-type="RESOURCE_LOCAL">


        <class>br.com.gmarqueszx.cadastropet.model.Pet</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <validation-mode>AUTO</validation-mode>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url"  value=""/>
            <property name="jakarta.persistence.jdbc.user"  value=""/>
            <property name="jakarta.persistence.jdbc.password"  value=""/>
            
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/> <!-- alterar para validate ou none em produção -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <property name="hibernate.hikari.maximumPoolSize" value="8" />
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider" />
        </properties>
    </persistence-unit>
</persistence>